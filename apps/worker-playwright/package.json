{
  "name": "worker-playwright",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@swarm/schemas": "workspace:*",
    "@swarm/js-sdk": "workspace:*",
    "fastify": "^4.28.1",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@playwright/test": "^1.49.0",
    "typescript": "^5.6.3",
    "eslint": "^9.13.0",
    "typescript-eslint": "^8.12.2",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.3.3",
    "@vitest/coverage-v8": "^2.1.4",
    "vitest": "^2.1.4"
  }
}
