{
  "name": "browser-challenge",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter worker-playwright test:e2e",
    "dev:worker": "pnpm --filter worker-playwright dev",
    "dev:fixture": "pnpm --filter fixture-web dev"
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.12.2"
  }
}
